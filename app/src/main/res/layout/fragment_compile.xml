<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔨 应用编译"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- 模型量化 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 模型量化"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="将模型量化为不同精度级别"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

                <!-- 选择要量化的模型 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="选择模型:"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/spinner_quantize_model"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp" />

                <!-- 量化类型选择 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="量化级别:"
                    android:textSize="14sp" />

                <RadioGroup
                    android:id="@+id/rg_quant_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_q2_k"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Q2_K (2.5bit) - 最小体积"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_q3_k"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Q3_K_M (3bit) - 较低精度"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_q4_k"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Q4_K_M (4bit) - 平衡模式 ⭐推荐"
                        android:textSize="12sp"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rb_q5_k"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Q5_K_M (5bit) - 较高精度"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_q6_k"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Q6_K (6bit) - 高精度"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_q8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Q8_0 (8bit) - 最高精度"
                        android:textSize="12sp" />

                </RadioGroup>

                <!-- 大小预估 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="原大小:"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_original_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="量化后:"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_quantized_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress_quantize"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    android:max="100" />

                <Button
                    android:id="@+id/btn_quantize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="开始量化"
                    android:enabled="false" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 应用编译 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📦 应用自编译"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="在 Android 设备上编译应用或使用云端编译"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

                <!-- 编译环境检查 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@android:color/background_light">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔧 编译环境"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Termux:"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_termux_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="检测中..."
                            android:textSize="12sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="NDK:"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_ndk_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="检测中..."
                            android:textSize="12sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="云端服务:"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_cloud_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="检测中..."
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="推荐方式:"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_recommended_method"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- 编译方式选择 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="选择编译方式:"
                    android:textSize="14sp" />

                <RadioGroup
                    android:id="@+id/rg_compile_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_local"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本地编译 (需要 Termux 或 NDK)"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_cloud"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="云端编译 (推荐，需网络)"
                        android:textSize="12sp"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rb_github"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GitHub Actions (需配置 GitHub)"
                        android:textSize="12sp" />

                </RadioGroup>

                <!-- 编译进度 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="编译进度:"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/progress_compile"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    android:max="100" />

                <TextView
                    android:id="@+id/tv_compile_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_compile_step"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

                <!-- 编译日志 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="编译日志:"
                    android:textSize="14sp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="4dp"
                    android:background="@android:color/black"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tv_build_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:fontFamily="monospace" />

                </ScrollView>

                <Button
                    android:id="@+id/btn_compile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="🚀 开始编译" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- APK 管理 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 APK 管理"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_apk_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="未生成 APK"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btn_install_apk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="安装"
                        android:enabled="false" />

                    <Button
                        android:id="@+id/btn_share_apk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="分享"
                        android:enabled="false" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
