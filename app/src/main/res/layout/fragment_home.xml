<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_chat">

    <!-- 内容由AI生成提示 -->
    <TextView
        android:id="@+id/tv_ai_notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="@string/ai_content_notice"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:background="@drawable/bg_ai_notice"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 模型解压进度提示栏 -->
    <LinearLayout
        android:id="@+id/extract_progress_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="@color/primary_light"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_ai_notice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_extract_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在解压模型..."
            android:textSize="14sp"
            android:textColor="@color/primary_dark"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_extract_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="准备中..."
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <ProgressBar
            android:id="@+id/progress_extract"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/primary" />

        <TextView
            android:id="@+id/tv_extract_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0%"
            android:textSize="12sp"
            android:textColor="@color/primary" />

    </LinearLayout>

    <!-- 服务状态提示栏 -->
    <LinearLayout
        android:id="@+id/service_status_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="@color/primary_light"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_ai_notice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/ic_dialog_info"
            app:tint="@color/primary_dark" />

        <TextView
            android:id="@+id/tv_service_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/service_not_started"
            android:textSize="12sp"
            android:textColor="@color/primary_dark" />

    </LinearLayout>

    <!-- 消息列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_messages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/service_status_bar"
        app:layout_constraintBottom_toTopOf="@id/input_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 空状态视图 -->
    <LinearLayout
        android:id="@+id/empty_state_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="32dp"
        app:layout_constraintTop_toBottomOf="@id/service_status_bar"
        app:layout_constraintBottom_toTopOf="@id/input_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_menu_send"
            android:alpha="0.3"
            app:tint="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="开始对话吧"
            android:textSize="16sp"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

    <!-- 新消息提示 -->
    <TextView
        android:id="@+id/tv_new_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="@string/new_message"
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:background="@drawable/bg_new_message"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/input_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 底部输入区域 -->
    <LinearLayout
        android:id="@+id/input_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_chat"
        android:elevation="4dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 附件预览区 -->
        <LinearLayout
            android:id="@+id/attachment_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone"
            android:background="@color/primary_light">

            <ImageView
                android:id="@+id/iv_attachment_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_attachment"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/tv_attachment_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="12sp"
                android:textColor="@color/primary_dark"
                android:maxLines="1"
                android:ellipsize="middle"
                tools:text="attachment.jpg" />

            <ImageButton
                android:id="@+id/btn_remove_attachment"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_secondary"
                android:contentDescription="移除附件" />

        </LinearLayout>

        <!-- 联网搜索开关 -->
        <LinearLayout
            android:id="@+id/web_search_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/web_search"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_web_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />

        </LinearLayout>

        <!-- 输入框和按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 联网搜索按钮 - 移至最左侧 -->
            <ImageButton
                android:id="@+id/btn_web_search"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/text_secondary"
                android:contentDescription="@string/web_search" />

            <!-- 添加附件按钮 -->
            <ImageButton
                android:id="@+id/btn_upload"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_add"
                app:tint="@color/text_secondary"
                android:contentDescription="@string/upload_file" />

            <!-- 输入框 -->
            <EditText
                android:id="@+id/et_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:minHeight="40dp"
                android:maxHeight="120dp"
                android:hint="@string/chat_hint"
                android:textColorHint="@color/input_hint"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:gravity="center_vertical"
                android:imeOptions="actionSend" />

            <!-- 发送按钮 -->
            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_send_button"
                android:src="@android:drawable/ic_menu_send"
                app:tint="@android:color/white"
                android:contentDescription="@string/btn_send" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
